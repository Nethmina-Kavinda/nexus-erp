# NEXUS ERP — Environment Variables
# Copy this file to backend/.env and fill in values

PORT=5001
MONGO_URI=mongodb://localhost:27017/nexus_erp
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
OTP_EMAIL=your_email@gmail.com
OTP_EMAIL_PASSWORD=your_app_password_here
ML_SERVICE_URL=http://127.0.0.1:5000
SKIP_OTP=true
NODE_ENV=development
