# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
backend/.env
*.env.local
*.env.*.local

# ── Python ────────────────────────────────────────────────────────────────────
ml-service/venv/
ml-service/__pycache__/
ml-service/**/__pycache__/
