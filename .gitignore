**/*.pyo
**/*.pyd
*.egg-info/
dist-info/

# ── ML model artefacts (regenerated by /train) ───────────────────────────────
ml-service/model.pkl

# ── Evaluation output (regenerated by evaluate.py) ───────────────────────────
ml-service/evaluation_output/

# ── Frontend build output ─────────────────────────────────────────────────────
frontend/dist/
frontend/.vite/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Claude Code internal files ────────────────────────────────────────────────
.claude/
_bmad/
_bmad-output/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

